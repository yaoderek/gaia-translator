OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase
# DATABASE_URL: use Transaction pooler from Supabase Dashboard → Project Settings → Database → Connection string → Transaction tab
DATABASE_URL=postgresql://postgres.yourproject:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://yourproject.supabase.co
# Anon/public key — served to the frontend via /api/config so Supabase auth works in production
SUPABASE_ANON_KEY=eyJhbGci...your-anon-public-key
SUPABASE_SERVICE_KEY=eyJhbGci...your-service-role-key
# Required for login/persona: Supabase Dashboard → Project Settings → API → tab "Legacy JWT Secret" → Reveal → copy the full value (no quotes)
SUPABASE_JWT_SECRET=your-legacy-jwt-secret-here
SUPABASE_STORAGE_BUCKET=gaia-papers

# CORS: comma-separated list of allowed origins (add your Fly.io URL for production)
CORS_ORIGINS=http://localhost:5173,https://gaia-translator.fly.dev
